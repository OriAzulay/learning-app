# Copy this file to .env (same folder) and adjust if needed.
# Both the backend and the Vite dev server read this single file.

# Port the Express API listens on (the Vite dev proxy forwards /api here)
PORT=3000

# The only browser origin allowed to call the API cross-origin (the Vite dev server)
CORS_ORIGIN=http://localhost:5173

# SQLite database file, relative to the backend/ folder
DB_PATH=data/app.db

# Max API requests per IP per minute
RATE_LIMIT_MAX=600

# How long cached GET responses live in memory, in milliseconds
CACHE_TTL_MS=30000
